# Relational database URL (e.g. PostgreSQL local, Supabase, Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/triageflow?schema=public"

# Secret key for signing JWT cookies (min 32 chars recommended)
AUTH_SECRET="your-super-secret-jwt-signing-key-here"

